# Copy to .env in the repo root.

PANTRY_DATABASE_URL=postgresql+psycopg://pantry:pantry@localhost:5432/pantry

PANTRY_LLM_PROVIDER=fake
PANTRY_LLM_MODEL=openai:gpt-4o-mini
# PANTRY_LLM_BASE_URL=
# PANTRY_LLM_TIMEOUT=30
# PANTRY_LLM_MAX_TOKENS=0
# PANTRY_LLM_MAX_RETRIES=2

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

PANTRY_ENV=development
PANTRY_MAINTENANCE=1

# JSON list. The default is the Next.js dev origins.
# PANTRY_CORS_ORIGINS=["http://localhost:3939","http://127.0.0.1:3939"]

NEXT_PUBLIC_API_URL=http://localhost:8787
