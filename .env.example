# Pantry Cook — Environment Variables
# Copy to .env and adjust as needed.

# Backend
PANTRY_DATABASE_URL=postgresql+psycopg://pantry:pantry@localhost:5432/pantry
PANTRY_LLM_PROVIDER=fake           # "fake" for offline dev, "real" with an API key
PANTRY_LLM_MODEL=openai:gpt-4o-mini
# OpenAI-compatible hosts (NVIDIA NIM, etc.) set a base URL and keep the openai: prefix.
# PANTRY_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# PANTRY_LLM_MODEL=openai:z-ai/glm-5.3-flash
# PANTRY_LLM_TIMEOUT=120
# PANTRY_LLM_MAX_TOKENS=4096
# PANTRY_LLM_MAX_RETRIES=1
OPENAI_API_KEY=                    # required only when LLM_PROVIDER=real

# production writes JSON logs; anything else uses a console renderer.
# PANTRY_ENV=development
# Set to 0 to skip the startup reconcile and the hourly abandoned-proposal sweep.
# PANTRY_MAINTENANCE=1

# LangSmith stays off unless tracing is requested and a key is set.
# The app does not import LangSmith; it only sets these variables.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pantry-cook

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8787
